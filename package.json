{
  "name": "withings-cli",
  "version": "0.3.0",
  "description": "Thin local-first CLI for the Withings Public API.",
  "keywords": [
    "bun",
    "cli",
    "health",
    "oauth2",
    "withings"
  ],
  "homepage": "https://github.com/Hiro5409/withings-cli#readme",
  "bugs": {
    "url": "https://github.com/Hiro5409/withings-cli/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiro5409/withings-cli.git"
  },
  "bin": {
    "withings": "bin/withings"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun run build:cli && bun run build:lib",
    "build:cli": "bun build src/main.ts --compile --outfile withings",
    "build:lib": "rm -rf dist && bun build src/index.ts --outfile dist/index.js --target browser && tsc -p tsconfig.dist.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "knip": "knip",
    "check:package": "rm -rf artifact && bun pm pack --destination artifact --quiet && publint run artifact/*.tgz && attw --profile esm-only artifact/*.tgz",
    "audit": "bun audit --audit-level=high",
    "secrets": "gitleaks git --no-banner --redact .",
    "prepare": "bun run build:lib",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run knip && bun test && bun run check:package"
  },
  "dependencies": {
    "gunshi": "^0.37.3",
    "valibot": "^1.5.0",
    "yoctocolors": "^2.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.4.2",
    "knip": "^6.36.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "publint": "^0.3.24",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
